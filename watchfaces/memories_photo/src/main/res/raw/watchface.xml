<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:08:32" />
    <UserConfigurations>
        <!-- v4: user picks photos in the companion app -->
        <PhotosConfiguration id="photos" displayName="photos_label" configType="MULTIPLE" defaultValue="@drawable/default_photo" changeAfterEvery="TAP" />
        <ListConfiguration id="advance" displayName="advance_label" defaultValue="0">
            <ListOption id="0" displayName="advance_tap" /><ListOption id="1" displayName="advance_hour" /><ListOption id="2" displayName="advance_day" />
        </ListConfiguration>
        <ListConfiguration id="clock_pos" displayName="clock_pos_label" defaultValue="2">
            <ListOption id="0" displayName="pos_top" /><ListOption id="1" displayName="pos_centre" /><ListOption id="2" displayName="pos_bottom" />
        </ListConfiguration>
        <BooleanConfiguration id="scrim" displayName="scrim_label" defaultValue="TRUE" />
        <Flavors defaultValue="gallery">
            <Flavor id="gallery" displayName="flavor_gallery"><Configuration id="clock_pos" optionId="2" /><Configuration id="scrim" optionId="TRUE" /></Flavor>
            <Flavor id="portrait" displayName="flavor_portrait"><Configuration id="clock_pos" optionId="0" /><Configuration id="scrim" optionId="TRUE" /></Flavor>
            <Flavor id="minimal" displayName="flavor_minimal"><Configuration id="clock_pos" optionId="1" /><Configuration id="scrim" optionId="FALSE" /></Flavor>
        </Flavors>
    </UserConfigurations>

    <Scene backgroundColor="#000000">
        <!-- Photo layer. In ambient we dim it rather than hide it (v4 transition). -->
        <Group x="0" y="0" width="450" height="450" name="photoLayer">
            <Variant mode="AMBIENT" target="alpha" value="90" duration="0.5" interpolation="EASE_IN_OUT" />
            <PartImage x="0" y="0" width="450" height="450" scaleType="CENTER_CROP">
                <Photos source="[CONFIGURATION.photos]" />
            </PartImage>
        </Group>

        <!-- Readability scrim -->
        <Condition>
            <Expressions><Expression name="s"><![CDATA[[CONFIGURATION.scrim] == "TRUE"]]></Expression></Expressions>
            <Compare expression="s">
                <PartDraw x="0" y="0" width="450" height="450" alpha="140">
                    <Rectangle x="0" y="0" width="450" height="450"><Fill><LinearGradient startX="225" startY="0" endX="225" endY="450" colors="#00000000 #000000" positions="0.35 1" /></Fill></Rectangle>
                </PartDraw>
            </Compare>
        </Condition>

        <!-- Clock, position chosen by user -->
        <ListConfiguration id="clock_pos">
            <ListOption id="0">
                <DigitalClock x="40" y="55" width="370" height="90"><TimeText format="hh:mm" align="START" hourFormat="SYNC_TO_DEVICE"><Font family="SYNC_TO_DEVICE" size="76" weight="BOLD" color="#FFFFFF" /></TimeText></DigitalClock>
                <PartText x="42" y="140" width="300" height="26"><Text align="START"><Font family="SYNC_TO_DEVICE" size="18" color="#FFC857"><Template>%s, %d %s<Parameter expression="[DAY_OF_WEEK_F]" /><Parameter expression="[DAY]" /><Parameter expression="[MONTH_S]" /></Template></Font></Text></PartText>
            </ListOption>
            <ListOption id="1">
                <DigitalClock x="40" y="175" width="370" height="100"><TimeText format="hh:mm" align="CENTER" hourFormat="SYNC_TO_DEVICE"><Font family="SYNC_TO_DEVICE" size="84" weight="BOLD" color="#FFFFFF" /></TimeText></DigitalClock>
            </ListOption>
            <ListOption id="2">
                <DigitalClock x="40" y="290" width="370" height="90"><TimeText format="hh:mm" align="START" hourFormat="SYNC_TO_DEVICE"><Font family="SYNC_TO_DEVICE" size="76" weight="BOLD" color="#FFFFFF" /></TimeText></DigitalClock>
                <PartText x="42" y="372" width="300" height="26"><Text align="START"><Font family="SYNC_TO_DEVICE" size="18" color="#FFC857"><Template>%s, %d %s<Parameter expression="[DAY_OF_WEEK_F]" /><Parameter expression="[DAY]" /><Parameter expression="[MONTH_S]" /></Template></Font></Text></PartText>
            </ListOption>
        </ListConfiguration>

        <ComplicationSlot slotId="0" x="330" y="330" width="60" height="60" supportedTypes="SHORT_TEXT SMALL_IMAGE" name="corner">
            <DefaultProviderPolicy defaultSystemProvider="STEP_COUNT" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingOval x="0" y="0" width="60" height="60" />
            <Complication type="SHORT_TEXT"><PartText x="0" y="0" width="60" height="60"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="16" color="#FFFFFF"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font></Text></PartText></Complication>
            <Complication type="SMALL_IMAGE"><PartImage x="15" y="15" width="30" height="30"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage></Complication>
        </ComplicationSlot>
    </Scene>
</WatchFace>
